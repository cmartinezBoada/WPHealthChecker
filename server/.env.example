# Copier en server/.env (ignoré par git)
WP_URL=https://exemple.local
WP_USER=admin
# Mot de passe d'application WordPress (Profil > Mots de passe d'application)
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Compte admin du tableau de bord
ADMIN_USER=admin
# Hash bcrypt : générer avec `npm run hash-password`, garder les apostrophes
ADMIN_PASSWORD_HASH='$2b$12$...'
# Secret de signature des cookies de session (32 caractères min.) : `openssl rand -base64 32`
SESSION_SECRET=

# Facultatif : certificat auto-signé du site (Local : ~/Library/Application Support/Local/run/router/nginx/certs/<site>.crt)
# WP_CA_CERT=

# Facultatif : port du backend (le proxy Vite pointe sur 3001)
# PORT=3001
